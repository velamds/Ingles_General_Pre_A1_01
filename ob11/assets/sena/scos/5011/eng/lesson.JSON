nt": "Reading", "value": "{\"type\": \"skill\", \"content\": \"Reading\"}", "type": "skill"}, {"valid": 1, "content": "Writing", "value": "{\"type\": \"skill\", \"content\": \"Writing\"}", "type": "skill"}, {"valid": 1, "content": "Speaking", "value": "{\"type\": \"skill\", \"content\": \"Speaking\"}", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment. ", "type": "text"}]}], "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"template_override": 1, "_data": [], "id": 0, "type": "welcome", "contents": [{}]}, {"title": "", "template_override": 1, "_data": [], "id": 1, "type": "audio", "contents": [{"value": {"audiosrc": "engenn1le01ob11re2aud01", "coverimg": "engenn1le01ob11re2img01.jpg", "images": [{"time": "0", "id": 0, "text": "", "image": "engenn1le01ob11re2img01.jpg"}, {"time": "20", "id": 1, "text": "<span class=\"strong\">Conversation&nbsp;1</span>", "image": "engenn1le01ob11re2img01.jpg"}, {"time": "100", "id": 2, "text": "<span class=\"strong\">Bob</span>: Good Morning, Miss Cook. How are you? Great weather today, right?<br/>\n<span class=\"strong\">Ms. Cook</span>: Morning Bob. How is your family?<br/>\n<span class=\"strong\">Bob</span>: Good. It's my mother's birthday on Friday.<br/>\n<span class=\"strong\">Ms. Cook</span>: How old is she?<br/>\n<span class=\"strong\">Bob</span>: She is 80 years old! Amazing, right?<br/>", "image": "engenn1le01ob11re2img01.jpg"}, {"time": "20000", "id": 3, "text": "<span class=\"strong\">Conversation&nbsp;2</span>", "image": "engenn1le01ob11re2img02.jpg"}, {"time": "26500", "id": 4, "text": "<span class=\"strong\">Mark</span>: Hi, is Veronica there?<br/>\n<span class=\"strong\">Mother</span>: No, she isn't.<br/>\n<span class=\"strong\">Mark</span>: OK, this is Mark. My phone number is 459-223-9986. My e-mail address is\nMark75@mail.com.<br/>\n<span class=\"strong\">Mother</span>: Mark75@mail.com? How do you spell that?<br/>\n<span class=\"strong\">Mark</span>: That's M-A-R-K75@mail.com.<br/>\n<span class=\"strong\">Mother</span>: OK, I got it.<br/>", "image": "engenn1le01ob11re2img02.jpg"}, {"time": "70000", "id": 5, "text": "<span class=\"strong\">Conversation&nbsp;3</span>", "image": "engenn1le01ob11re2img03.jpg"}, {"time": "77500", "id": 6, "text": "<span class=\"strong\">Scott</span>: So, Andrea, this is your family?<br/>\n<span class=\"strong\">Andrea</span>: Yes, that's my sister, Ashley. She is 13 years old. And that's my brother, James. He is the middle child. Those are my parents over there - Jill, my mother and Barry, my father. And these are my dogs, Spot and Blue.  Shhhhh!", "image": "engenn1le01ob11re2img03.jpg"}]}, "type": "slideshow"}]}], "id": 0, "type": "scholar"}]}